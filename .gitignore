.claude/
.gstack/
.agents/
.codex/

# The detector waiver is a decision about this project and has to survive a
# fresh clone, so .impeccable is ignored by *contents* — git cannot re-include a
# file whose parent directory is itself excluded. Caches and per-user overrides
# under it stay ignored. Not served either way; see .assetsignore.
.impeccable/*
!.impeccable/config.json

# Internal docs — this repo is PUBLIC, so project notes stay local-only.
# OneDrive is their only backup; there is no git history for these files.
CLAUDE.md
AGENTS.md
README.md
DESIGN.md
PRODUCT.md
TODOS.md
STEP-BY-STEP.md
USER-GUIDE.md
docs/
archive/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example


# Hero selection, 2026-08-20 — local only until Luke picks one.
# _hero-preview.html is generated from index.html by
# docs/hero-selection/make-preview.py; the hero-* candidates are generated
# from the masters in OneDrive media-source by build-heroes.py. When Luke
# picks, delete the matching line below and commit just the chosen photo's
# four variants — and un-ignore it in .assetsignore too, or the file is in
# git but never served.
#
# Picked 2026-08-21: hero-congregation-hands (home hero, both breakpoints)
# and hero-preaching-podium (sermons page hero). Both now committed.
#
# The four candidates Luke passed on were deleted from disk 2026-08-21 — they
# were never in git, so this is their only record. The 1400px canonicals of
# hero-congregation-vertical and hero-teaching-slide are preserved in
# media-source/photos-raw/hero-candidates-2026-08-20/, and the other two in
# photos-raw/unused-2026-08-21/. The rules below stay so that re-running
# build-heroes.py cannot accidentally commit regenerated candidates.
_hero-preview.html
assets/photos/home/hero-congregation-vertical-*.jpg
assets/photos/home/hero-congregation-vertical.jpg
assets/photos/home/hero-teaching-slide-*.jpg
assets/photos/home/hero-teaching-slide.jpg
assets/photos/home/hero-worship-band-*.jpg
assets/photos/home/hero-worship-band.jpg
assets/photos/home/hero-worship-leader-lyrics-*.jpg
assets/photos/home/hero-worship-leader-lyrics.jpg

# Colour selection, 2026-08-30 — Luke's readers found the bottom of the page
# too green and the gold CTA too collegiate. _color-preview.html is generated
# from index.html by docs/color-options/make-preview.py and is a throwaway.
# The real changes, once colours are picked, are a scoped .site-footer rule
# and .btn-gold in style.css. Delete this block when it's decided.
_color-preview.html
