{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selah-church",
  "compatibility_date": "2026-07-23",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "SERMONS_KV",
      "id": "d55733766a2e494a956a6b450c5cd2d8"
    }
  ],
  "triggers": {
    // Once a day at 10:00 UTC (~6am Eastern) — see STEP-BY-STEP.md if this
    // needs to move.
    "crons": ["0 10 * * *"]
  }
}
